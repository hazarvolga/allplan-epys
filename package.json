{
  "name": "allplan-digital-project",
  "version": "0.1.0",
  "private": true,
  "packageManager": "pnpm@11.17.0",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "next dev --hostname 127.0.0.1 --port 3100",
    "build": "pnpm content:check && tsx scripts/check-config.ts && next build",
    "start": "next start --hostname 127.0.0.1 --port 3100",
    "lint": "eslint .",
    "typecheck": "next typegen && tsc --noEmit",
    "content:check": "tsx scripts/check-content.ts",
    "test": "vitest run --coverage",
    "test:e2e": "playwright test",
    "format": "prettier --write ."
  },
  "dependencies": {
    "next": "16.4.0",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "next-intl": "4.14.9",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "tailwindcss": "^4",
    "typescript": "^5",
    "@types/node": "^24",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.4.0",
    "eslint-plugin-jsx-a11y": "^6.10.2",
    "prettier": "^3",
    "tsx": "^4",
    "vitest": "^4",
    "@vitest/coverage-v8": "^4",
    "@playwright/test": "^1.58",
    "@axe-core/playwright": "^4.11"
  }
}
