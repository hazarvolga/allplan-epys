# Never commit the actual .env.local. The form fails closed until configured.
PUBLISHER_NAME=Aluplan
DEMO_WEBHOOK_URL=
DEMO_WEBHOOK_TOKEN=
# Set true only after the publisher, privacy notice and KVKK text are approved.
DEMO_LEGAL_READY=false
# Generate a random secret of at least 32 bytes. Used only for rate-limit HMAC keys.
DEMO_RATE_SECRET=
# Required for production; compatible Redis REST service with EVAL support.
# Five attempts per IP AND per email per 15 minutes. Hashed keys expire automatically.
DEMO_REDIS_REST_URL=
DEMO_REDIS_REST_TOKEN=
# Empty fails safely to a shared unknown-IP bucket. Do not trust arbitrary X-Forwarded-For.
# vercel: only when the origin can be reached exclusively through Vercel.
# nginx: only when a trusted reverse proxy overwrites X-Real-IP and origin is private.
DEMO_TRUST_PROXY=
# Webhook must accept bearer auth and Idempotency-Key, and deduplicate retries.
# An accepted 2xx response must mean durable receipt; 8-second delivery timeout.
# Server never logs submitted fields. Receiver retention/access must match KVKK notice.

# Canonical origin for THIS site. Leave blank for non-indexable local preview.
NEXT_PUBLIC_SITE_URL=
NEXT_PUBLIC_PUBLISHER=Aluplan
NEXT_PUBLIC_AFFILIATION=ALLPLAN Türkiye distribütörü
NEXT_PUBLIC_CONTENT_AUTHOR=
NEXT_PUBLIC_CONTENT_REVIEWER=
# Optional privacy assessment required before enabling analytics.
NEXT_PUBLIC_PLAUSIBLE_DOMAIN=
ALLOW_AI_CRAWLERS=true
